CompileFlags:
  CompilationDatabase: "."
  Compiler: C:/msys64/ucrt64/bin/g++.exe
  Add:
    - "-std=c++17"
    - "--driver-mode=g++"
    - "--target=x86_64-w64-windows-gnu"
    - "-Wno-builtin-macro-redefined"
    - "-Wno-incompatible-ms-struct"
Diagnostics:
  Suppress:
    - "redefinition of"
    - "definition of builtin function"
    - "builtin_definition"
